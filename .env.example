# =====================================================================
# REQUIRED - core
# =====================================================================

PORT=3000
NODE_ENV=development

# PostgreSQL connection string (Prisma format)
DATABASE_URL=postgresql://bridge:bridge@localhost:5432/bridge_backend?schema=public

# Signs JWTs issued to ORG_ADMIN / SUPER_ADMIN sessions on login.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# AES-256-GCM key used to encrypt each organization's Zoho refresh token at
# rest. Must be exactly 32 bytes, hex-encoded (64 hex characters).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Zoho API Console OAuth client. One client is shared across all
# organizations; each organization's own refresh token (obtained via
# /api/zoho/connect) is what actually scopes access to their Zoho account.
ZOHO_CLIENT_ID=1000.MLCDPC8JQZIQG8XYYZ9BFY6J28MJ1K
ZOHO_CLIENT_SECRET=9b549f6440f475d92d2045b4ebcd8348244f9a4900
ZOHO_REDIRECT_URI=https://api.myproduct.com/api/zoho/callback

# Public base URL of this Bridge, as the Electron Agent will call it.
API_BASE_URL=https://api.myproduct.com

# =====================================================================
# OPTIONAL - has a sane default, override if needed
# =====================================================================

# Zoho data center for the shared OAuth client's accounts.zoho.<dc> and
# www.zohoapis.<dc> endpoints. A per-organization override lives in the
# zoho_connections table (dataCenter column) and wins over this default.
ZOHO_DEFAULT_DC=in

# How long an issued device token remains valid before the Agent must
# re-enroll. Leave unset for tokens that don't expire.
DEVICE_TOKEN_TTL_DAYS=

# Sync retry tuning (src/services/sync)
SYNC_MAX_ATTEMPTS=8
SYNC_BASE_BACKOFF_MS=30000
SYNC_MAX_BACKOFF_MS=3600000
SYNC_WORKER_INTERVAL_MS=15000
SYNC_WORKER_BATCH_SIZE=25

# Inbound rate limiting (express-rate-limit)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

LOG_LEVEL=info

# =====================================================================
# REQUIRED FOR LOCAL DEV / CI ONLY - not used in production
# =====================================================================

# Separate database for the automated test suite (tests/setup.js runs
# `prisma migrate deploy` against this before the suite starts, and each
# test file gets a clean slate). Never point this at a real database.
DATABASE_URL_TEST=postgresql://bridge:bridge@localhost:5432/bridge_backend_test?schema=public

# Bootstraps exactly one SUPER_ADMIN row (npm run prisma:seed). Change the
# password immediately after first login in any real deployment.
SUPER_ADMIN_EMAIL=super@example.com
SUPER_ADMIN_PASSWORD=change-me-immediately
